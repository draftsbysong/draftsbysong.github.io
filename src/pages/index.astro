---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatShortDate, getPostSlug, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  const group = byYear.get(year) ?? [];
  group.push(post);
  byYear.set(year, group);
}

const years = Array.from(byYear.keys()).sort((a, b) => b - a);
---

<BaseLayout currentPath="/">
  <p class="intro">
    Working drafts, notes, and essays by Song.
  </p>

  {years.length === 0 ? (
    <p style="color: var(--muted);">No published drafts yet.</p>
  ) : (
    years.map((year) => (
      <section class="year-group" aria-labelledby={`year-${year}`}>
        <h2 class="year-heading" id={`year-${year}`}>{year}</h2>
        <ul class="post-list">
          {(byYear.get(year) ?? []).map((post) => (
            <li class="post-item">
              <time class="post-date" datetime={post.data.date.toISOString()}>
                {formatShortDate(post.data.date)}
              </time>
              <div class="post-link-wrap">
                <a class="post-link" href={`/posts/${getPostSlug(post.id)}/`}>
                  {post.data.title}
                </a>
                {post.data.stage && (
                  <span class="stage-badge">{post.data.stage}</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</BaseLayout>
